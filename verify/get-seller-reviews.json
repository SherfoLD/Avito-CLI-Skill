{
  "args": [
    "https://www.avito.ru/moskva/tovary_dlya_detey_i_igrushki/kolyaska_2_v_1_stokke_scoot_2194767053",
    "--sort",
    "date_asc"
  ],
  "expect": {
    "rowCount": { "min": 1, "max": 25 },
    "columns": ["reviewId", "score", "stage", "rated", "authorName", "authorRole", "itemTitle", "text", "answerText", "answered", "images", "sellerReviewsCount"],
    "types": {
      "reviewId": "number",
      "score": "number|null",
      "stage": "string|null",
      "rated": "string|null",
      "authorName": "string",
      "authorRole": "string|null",
      "itemTitle": "string|null",
      "text": "string|null",
      "answerText": "string|null",
      "answered": "string|null",
      "images": "array",
      "sellerReviewsCount": "number|null"
    },
    "patterns": {
      "stage": "^(Сделка состоялась|Не договорились)$",
      "authorRole": "^Покупатель$",
      "rated": "^\\d{1,2} [а-яё]+( \\d{4})?$"
    },
    "notEmpty": ["reviewId", "stage", "rated", "authorName", "authorRole", "itemTitle", "text"],
    "mustBeTruthy": ["sellerReviewsCount"]
  }
}
