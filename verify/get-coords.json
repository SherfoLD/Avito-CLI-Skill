{
  "args": [
    "Тверь, Советская улица, 11"
  ],
  "expect": {
    "rowCount": {
      "min": 1,
      "max": 1
    },
    "columns": [
      "address",
      "kind",
      "locality",
      "latitude",
      "longitude",
      "postalCode"
    ],
    "types": {
      "address": "string",
      "kind": "string",
      "locality": "string",
      "latitude": "number",
      "longitude": "number",
      "postalCode": "string"
    },
    "patterns": {
      "address": "^Россия, Тверь, Советская улица, 11$",
      "kind": "^house$",
      "locality": "^Тверь$",
      "postalCode": "^\\d{6}$"
    },
    "notEmpty": [
      "address",
      "kind",
      "locality",
      "postalCode"
    ],
    "mustBeTruthy": [
      "latitude",
      "longitude"
    ]
  }
}
