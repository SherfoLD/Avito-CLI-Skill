{
  "args": [
    "Казань",
    "--geo",
    "metro",
    "--geo-query",
    "Кремл"
  ],
  "expect": {
    "rowCount": {
      "min": 1,
      "max": 1
    },
    "columns": [
      "rank",
      "locationId",
      "locationName",
      "geoMode",
      "geoId",
      "geoName",
      "geoGroup"
    ],
    "types": {
      "rank": "number",
      "locationId": "string",
      "locationName": "string",
      "geoMode": "string",
      "geoId": "string",
      "geoName": "string",
      "geoGroup": "string"
    },
    "patterns": {
      "locationId": "^\\d+$",
      "geoId": "^\\d+$",
      "geoMode": "^metro$"
    },
    "notEmpty": [
      "locationId",
      "locationName",
      "geoMode",
      "geoId",
      "geoName",
      "geoGroup"
    ],
    "mustBeTruthy": [
      "rank"
    ]
  }
}
